# ── Functions ────────────────────────────────────────────────────────────────
mkcd() { mkdir -p -- "$1" && cd -- "$1" || return; }
up()   { local n=${1:-1} p=; while (( n-- > 0 )); do p+=../; done; cd "${p:-.}" || return; }
bak()  { cp -a -- "$1" "$1.bak.$(date +%Y%m%d-%H%M%S)"; }
extract() {
    case $1 in
        *.tar.gz|*.tgz)   tar xzf "$1" ;;
        *.tar.bz2|*.tbz2) tar xjf "$1" ;;
        *.tar.xz)         tar xJf "$1" ;;
        *.tar.zst)        tar --zstd -xf "$1" ;;
        *.tar)            tar xf "$1" ;;
        *.gz)             gunzip "$1" ;;
        *.zip)            unzip "$1" ;;
        *.7z)             7z x "$1" ;;
        *.rar)            unrar x "$1" ;;
        *) echo "Unsupported format: $1" >&2; return 1 ;;
    esac
}
path() { local IFS=:; printf '%s\n' $PATH; }
# Which process owns a port
whoport() { if [[ $__win ]]; then netstat -ano | grep ":$1 "; else ss -tulpn "sport = :$1"; fi; }
# Time any command N times: rep 5 cmd...
rep() { local n=$1; shift; while (( n-- > 0 )); do "$@" || return; done; }

